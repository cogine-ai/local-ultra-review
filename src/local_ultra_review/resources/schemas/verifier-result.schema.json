{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ultra-review:v2:verifier-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "packet_hash",
    "candidate_hash",
    "status",
    "disposition",
    "provenance",
    "best_fix",
    "refactor_judgment",
    "proof",
    "residual_risk"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-evaluation-slice"
    },
    "task_id": {
      "type": "string",
      "pattern": "^verifier-.+"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "completed"
    },
    "disposition": {
      "enum": [
        "confirmed",
        "false_positive",
        "pre_existing",
        "needs_manual_review"
      ]
    },
    "final_severity": {
      "enum": ["Important", "Nit"]
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "best_fix": {
      "type": "string",
      "minLength": 1
    },
    "refactor_judgment": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "confirmed"
          }
        },
        "required": ["disposition"]
      },
      "then": {
        "required": ["final_severity"]
      },
      "else": {
        "not": {
          "required": ["final_severity"]
        }
      }
    }
  ]
}
