{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-ultra-review:v2:evaluation-completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "authoritative_review",
    "execution_backend",
    "profile",
    "release_ready",
    "session_id",
    "plan_integrity_hash",
    "review_identity_hash",
    "protocol_completeness",
    "simulated_review_verdict",
    "reviewer_execution_state",
    "worker_dispatch_state",
    "coverage",
    "accounting",
    "reviewer_artifact_hash",
    "verifier_artifact_hashes",
    "verifier_disposition_records",
    "canonical_finding_hashes",
    "canonical_finding_records",
    "manual_item_hashes",
    "manual_item_records",
    "accepted_artifact_hashes",
    "assurance_contract_under_test"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-evaluation-slice"
    },
    "authority": {
      "const": "synthetic_evaluation"
    },
    "authoritative_review": {
      "const": false
    },
    "execution_backend": {
      "const": "fake_evaluation"
    },
    "profile": {
      "const": "evaluation_slice_v2"
    },
    "release_ready": {
      "const": false
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_integrity_hash": {
      "$ref": "#/$defs/sha256"
    },
    "review_identity_hash": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_completeness": {
      "const": "complete"
    },
    "simulated_review_verdict": {
      "enum": ["clean", "findings", "manual_review_required"]
    },
    "reviewer_execution_state": {
      "enum": ["completed", "not_applicable_no_reviewable_atoms"]
    },
    "worker_dispatch_state": {
      "enum": ["synthetic_attempts_accepted", "not_applicable_no_reviewable_atoms"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_atoms", "reviewed_atoms", "manual_atoms"],
      "properties": {
        "total_atoms": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "manual_atoms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_candidates",
        "verifier_results",
        "confirmed_candidate_dispositions",
        "canonical_findings",
        "false_positive",
        "pre_existing",
        "needs_manual_review",
        "adapter_manual_items"
      ],
      "properties": {
        "raw_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "verifier_results": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_candidate_dispositions": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_findings": {
          "type": "integer",
          "minimum": 0
        },
        "false_positive": {
          "type": "integer",
          "minimum": 0
        },
        "pre_existing": {
          "type": "integer",
          "minimum": 0
        },
        "needs_manual_review": {
          "type": "integer",
          "minimum": 0
        },
        "adapter_manual_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewer_artifact_hash": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "verifier_artifact_hashes": {
      "$ref": "#/$defs/hashArray"
    },
    "verifier_disposition_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/verifierDispositionRecord"}
    },
    "canonical_finding_hashes": {
      "$ref": "#/$defs/hashArray"
    },
    "canonical_finding_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/canonicalFindingRecord"}
    },
    "manual_item_hashes": {
      "$ref": "#/$defs/hashArray"
    },
    "manual_item_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/manualItemRecord"}
    },
    "accepted_artifact_hashes": {
      "$ref": "#/$defs/hashArray"
    },
    "assurance_contract_under_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_profile",
        "worker_boundary",
        "hard_worker_confinement",
        "input_discipline",
        "packet_only_read",
        "residual_tool_surface",
        "residual_tool_inventory",
        "accepted_tool_calls",
        "telemetry_scope",
        "worker_child_environment",
        "filesystem_write_mitigation",
        "nested_web_search",
        "broader_network_denial",
        "connector_github_denial",
        "ambient_secret_non_access",
        "context_lineage",
        "backend_stateless_attestation",
        "target_execution"
      ],
      "properties": {
        "worker_profile": {
          "const": "codex_native_guarded"
        },
        "worker_boundary": {
          "const": "guarded_unconfined"
        },
        "hard_worker_confinement": {
          "const": "not_provided"
        },
        "input_discipline": {
          "const": "adapter_packet_minimized"
        },
        "packet_only_read": {
          "const": "not_guaranteed"
        },
        "residual_tool_surface": {
          "const": "unknown"
        },
        "residual_tool_inventory": {
          "const": "unavailable"
        },
        "accepted_tool_calls": {
          "enum": ["none_observed", "not_applicable_no_dispatch"]
        },
        "telemetry_scope": {
          "enum": ["observed_events_only", "not_applicable_no_dispatch"]
        },
        "worker_child_environment": {
          "const": "not_verified"
        },
        "filesystem_write_mitigation": {
          "const": "not_verified"
        },
        "nested_web_search": {
          "const": "not_verified"
        },
        "broader_network_denial": {
          "const": "not_guaranteed"
        },
        "connector_github_denial": {
          "const": "not_guaranteed"
        },
        "ambient_secret_non_access": {
          "const": "not_guaranteed"
        },
        "context_lineage": {
          "enum": ["fresh_process_inferred", "not_applicable_no_dispatch"]
        },
        "backend_stateless_attestation": {
          "const": "unavailable"
        },
        "target_execution": {
          "const": "not_requested"
        }
      }
    }
  },
  "$defs": {
    "verifierDispositionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_hash",
        "duplicate_ordinal",
        "verifier_result_envelope_hash",
        "disposition",
        "final_severity"
      ],
      "properties": {
        "candidate_hash": {"$ref": "#/$defs/sha256"},
        "duplicate_ordinal": {"type": "integer", "minimum": 0},
        "verifier_result_envelope_hash": {"$ref": "#/$defs/sha256"},
        "disposition": {
          "enum": ["confirmed", "false_positive", "pre_existing", "needs_manual_review"]
        },
        "final_severity": {
          "oneOf": [
            {"enum": ["Important", "Nit"]},
            {"type": "null"}
          ]
        }
      }
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "confirmedInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_hash", "duplicate_ordinal", "verifier_result_envelope_hash", "final_severity"],
      "properties": {
        "candidate_hash": {"$ref": "#/$defs/sha256"},
        "duplicate_ordinal": {"type": "integer", "minimum": 0},
        "verifier_result_envelope_hash": {"$ref": "#/$defs/sha256"},
        "final_severity": {"enum": ["Important", "Nit"]}
      }
    },
    "rootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "title", "failure_scenario", "evidence", "why_diff"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "line": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "failure_scenario": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/nonemptyStringArray"},
        "why_diff": {"type": "string", "minLength": 1}
      }
    },
    "canonicalFindingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause",
        "merged_final_severity",
        "confirmed_instances",
        "proof",
        "provenance",
        "best_fix",
        "refactor_judgment",
        "residual_risk",
        "canonical_finding_hash"
      ],
      "properties": {
        "root_cause": {"$ref": "#/$defs/rootCause"},
        "merged_final_severity": {"enum": ["Important", "Nit"]},
        "confirmed_instances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/confirmedInstance"}
        },
        "proof": {"$ref": "#/$defs/nonemptyStringArray"},
        "provenance": {"$ref": "#/$defs/nonemptyStringArray"},
        "best_fix": {"$ref": "#/$defs/nonemptyStringArray"},
        "refactor_judgment": {"$ref": "#/$defs/nonemptyStringArray"},
        "residual_risk": {"$ref": "#/$defs/nonemptyStringArray"},
        "canonical_finding_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "manualDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "atom_ids", "disposition_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "atom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^atom-.+"}
        },
        "disposition_id": {"type": "string", "minLength": 1}
      }
    },
    "manualItemRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "disposition", "manual_item_hash"],
          "properties": {
            "domain": {"const": "adapter_manual_disposition"},
            "disposition": {"$ref": "#/$defs/manualDisposition"},
            "manual_item_hash": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "candidate_hash",
            "duplicate_ordinal",
            "verifier_result_envelope_hash",
            "manual_item_hash"
          ],
          "properties": {
            "domain": {"const": "verifier_needs_manual_review"},
            "candidate_hash": {"$ref": "#/$defs/sha256"},
            "duplicate_ordinal": {"type": "integer", "minimum": 0},
            "verifier_result_envelope_hash": {"$ref": "#/$defs/sha256"},
            "manual_item_hash": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
